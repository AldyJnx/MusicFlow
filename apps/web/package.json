{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "description": "MusicFlow Desktop",
  "author": "MusicFlow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "electron": "electron electron/main.cjs",
    "dist:win": "pnpm run build && electron-builder --win --x64",
    "dist:linux": "pnpm run build && electron-builder --linux --x64",
    "dist:mac": "pnpm run build && electron-builder --mac --universal",
    "pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "compress-images": "node scripts/compress-images.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "animejs": "^4.4.1",
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.12.0",
    "motion": "^12.42.0",
    "music-metadata": "^11.13.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.14.2",
    "wavesurfer.js": "^7.10.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "app.musicflow.desktop",
    "productName": "MusicFlow",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "src/assets/Logo_Music_Flow-FormatoIco.ico",
        "to": "musicflow.ico"
      }
    ],
    "win": {
      "icon": "src/assets/Logo_Music_Flow-FormatoIco.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "AudioVideo;Audio;Music",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
