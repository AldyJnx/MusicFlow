# ===========================================
# MusicFlow Backend - Environment Variables
# ===========================================

# App
NODE_ENV=development
PORT=8000
ENABLE_SWAGGER=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://musicflow:musicflow_dev@localhost:5432/musicflow_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Optional error monitoring. Leave empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage (Cloudflare R2 - S3-compatible)
R2_ENDPOINT=https://e6059b4515b414d738310669c6ca5977.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_AUDIO=music-flow
R2_BUCKET_IMAGES=music-flow-images
# Artist portraits are always stored in their dedicated bucket with the exact
# key `{artista}.webp|avif`; configure this bucket's public R2/custom URL.
R2_BUCKET_ARTIST_IMAGES=music-flow-artist-image
R2_PUBLIC_ARTIST_IMAGES_URL=
R2_BUCKET_LYRICS=music-flow-songs-lyrics
R2_BUCKET_ARTIST_EVIDENCE=portal-artist-evidence
R2_PUBLIC_AUDIO_URL=https://pub-f44a489bc1e94270836132b3136f0a8c.r2.dev
R2_PUBLIC_IMAGES_URL=https://pub-7f3d08bcabf44d68b2a57424acfc9d48.r2.dev
# Public base of the lyrics bucket. Admin shows this stable Cloudflare R2 URL
# when a song already has lyrics; when it is blank, it uses a temporary signed
# R2 URL so the editor can still load and edit the file safely.
R2_PUBLIC_LYRICS_URL=

# Claude AI (end-user player assistant; metered by the monthly AI quota)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# NVIDIA NIM (admin-only catalog quality assistant).
# This provider is never reachable from end-user routes: only
# AdminController-level guards can call it, and it has its own model, its own
# tables and its own rate limits, separate from the Claude quota above.
# Create a free key at https://build.nvidia.com/settings/api-keys (prefix nvapi-).
# The free tier is prototyping-only: roughly 40 requests per minute, best
# effort, with no SLA. Leave NVIDIA_API_KEY empty to disable the whole feature;
# the deterministic catalog report keeps working without it.
NVIDIA_API_KEY=
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_AI_TIMEOUT_MS=60000
NVIDIA_AI_MAX_RETRIES=2
# Upper bound of items sent to the model in a single request. Batching keeps
# the request count low enough for the 40 RPM free tier.
CATALOG_AI_MAX_BATCH=25

# Mercado Pago (reserved; billing routes remain disabled until integration)
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_TEST_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_PREAPPROVAL_PLAN_ID=
MERCADO_PAGO_PREAPPROVAL_PLAN_ID=

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# App URL (for email links)
APP_URL=http://localhost:5173

# Google OAuth (server-side Passport flow; keep the secret out of Git)
# Callback must exactly match the URI registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Google OAuth for native mobile (POST /auth/google/mobile).
# Comma-separated allow-list of the audiences accepted in a Google ID token.
# Use the WEB OAuth client ID: the mobile app passes it as `serverClientId`, so
# it becomes the `aud` claim. The Android client ID is not valid here.
# Leave empty to keep the endpoint disabled (it answers 503).
GOOGLE_MOBILE_AUDIENCES=


# SMTP (optional - if unset, MailService logs links to console in dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@musicflow.com
