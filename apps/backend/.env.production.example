NODE_ENV=production
PORT=8000
ENABLE_SWAGGER=false
DATABASE_URL=postgresql://replace-me
REDIS_URL=rediss://replace-me
JWT_SECRET=replace-with-32-or-more-random-bytes
JWT_REFRESH_SECRET=replace-with-an-independent-random-secret
CORS_ORIGINS=https://app.example.com
SENTRY_ENVIRONMENT=production
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
THROTTLE_TTL=60
THROTTLE_LIMIT=100
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=music-flow
R2_BUCKET_IMAGES=music-flow-images
R2_BUCKET_ARTIST_IMAGES=music-flow-artist-image
R2_BUCKET_LYRICS=music-flow-songs-lyrics
R2_PUBLIC_AUDIO_URL=https://audio.example.com
R2_PUBLIC_IMAGES_URL=https://images.example.com
R2_PUBLIC_LYRICS_URL=https://lyrics.example.com
ANTHROPIC_API_KEY=
