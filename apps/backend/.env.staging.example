NODE_ENV=staging
PORT=8000
ENABLE_SWAGGER=true
DATABASE_URL=postgresql://replace-me
REDIS_URL=rediss://replace-me
JWT_SECRET=replace-with-32-or-more-random-bytes
JWT_REFRESH_SECRET=replace-with-an-independent-random-secret
CORS_ORIGINS=https://staging.example.com
SENTRY_ENVIRONMENT=staging
SENTRY_DSN=
THROTTLE_TTL=60
THROTTLE_LIMIT=100
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=music-flow-staging
R2_BUCKET_IMAGES=music-flow-images-staging
R2_BUCKET_ARTIST_IMAGES=music-flow-artist-image-staging
R2_BUCKET_LYRICS=music-flow-songs-lyrics-staging
R2_PUBLIC_AUDIO_URL=https://staging-audio.example.com
R2_PUBLIC_IMAGES_URL=https://staging-images.example.com
R2_PUBLIC_LYRICS_URL=https://staging-lyrics.example.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# NVIDIA NIM, admin-only. Free tier is prototyping-only (no SLA).
NVIDIA_API_KEY=
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_AI_TIMEOUT_MS=60000
NVIDIA_AI_MAX_RETRIES=2
CATALOG_AI_MAX_BATCH=25
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_PREAPPROVAL_PLAN_ID=
APP_URL=https://staging.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@staging.example.com
