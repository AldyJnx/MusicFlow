# Copia este archivo como `.env.vps` en la VPS. Nunca lo confirmes en Git.
API_DOMAIN=api.example.com
TLS_EMAIL=admin@example.com

# PostgreSQL y Redis internos. Usa caracteres URL-safe en las contraseñas
# porque POSTGRES_PASSWORD también forma parte de DATABASE_URL.
POSTGRES_DB=musicflow
POSTGRES_USER=musicflow
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Aplicación
NODE_ENV=production
PORT=8000
ENABLE_SWAGGER=false
CORS_ORIGINS=https://app.example.com
APP_URL=https://app.example.com
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudflare R2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=music-flow
R2_BUCKET_IMAGES=music-flow-images
R2_BUCKET_ARTIST_IMAGES=music-flow-artist-image
R2_BUCKET_LYRICS=music-flow-songs-lyrics
R2_BUCKET_ARTIST_EVIDENCE=portal-artist-evidence
R2_PUBLIC_AUDIO_URL=https://audio.example.com
R2_PUBLIC_IMAGES_URL=https://images.example.com
R2_PUBLIC_ARTIST_IMAGES_URL=https://artists.example.com
R2_PUBLIC_LYRICS_URL=https://lyrics.example.com

# IA de usuarios y administrador
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
NVIDIA_API_KEY=
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_AI_TIMEOUT_MS=60000
NVIDIA_AI_MAX_RETRIES=2
CATALOG_AI_MAX_BATCH=25

# OAuth de Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
GOOGLE_MOBILE_AUDIENCES=

# Notificaciones push. Usa el JSON completo de una cuenta de servicio de
# Firebase en una sola línea; no confirmes el valor real en Git.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mercado Pago. Déjalos vacíos mientras billing siga deshabilitado.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PREAPPROVAL_PLAN_ID=

# Correo y observabilidad opcionales
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
PRISMA_QUERY_LOGS=false
NEST_BOOTSTRAP_LOGS=false
